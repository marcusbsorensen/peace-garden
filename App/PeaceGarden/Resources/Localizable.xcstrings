    "Tell it differently" : {
      "comment" : "Button, and the title of the screen it opens. Changes what a kept plant says about the meeting — the name, the place — without changing the plant.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
