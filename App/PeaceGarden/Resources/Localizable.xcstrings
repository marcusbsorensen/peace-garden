    "If they scan this QR code, a plant will grow on both of your phones. It is a mix of the unique seeds on them." : {
      "comment" : "Above the QR code, and the whole of what to do next.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis de scanner denne QR-kode, gror der en plante frem på begge jeres telefoner. Den er en blanding af de enestående frø på dem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la otra persona escanea este código QR, crecerá una planta en los dos teléfonos. Es una mezcla de las semillas únicas que hay en ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si l’autre personne scanne ce QR code, une plante pousse sur vos deux téléphones. Elle est un mélange des graines uniques qui s’y trouvent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se l’altra persona scansiona questo codice QR, cresce una pianta su entrambi i telefoni. È una miscela dei semi unici che vi si trovano."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis de skanner denne QR-koden, vokser det fram en plante på begge telefonene. Den er en blanding av de unike frøene på dem."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als de ander deze QR-code scant, groeit er op allebei jullie telefoons een plant. Die is een mengsel van de unieke zaadjes erop."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om de skannar den här QR-koden växer det fram en växt på båda telefonerna. Den är en blandning av de unika fröna på dem."
          }
        }
      }
    },
