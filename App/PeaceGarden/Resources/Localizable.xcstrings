    "Touch the tops of your phones together" : {
      "comment" : "Title at the moment the two phones have found each other and are waiting for the knock. The gesture is the top edge of one phone against the top edge of the other.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rør telefonernes toppe mod hinanden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta la parte de arriba de los dos teléfonos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le haut de vos téléphones l’un contre l’autre"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca le parti alte dei vostri telefoni"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Berør toppene av telefonene mot hverandre"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raak de bovenkanten van jullie telefoons tegen elkaar"
          }
        },
        "sv" : {
