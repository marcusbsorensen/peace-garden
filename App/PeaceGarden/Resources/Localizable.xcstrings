{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ cannot grow this plant without a seed from you. Show them this, or send it." : {
      "comment" : "Under the code to send back, once a seed that arrived by link has been kept. %@ is the other person's name.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ikke gro denne plante uden et frø fra dig. Vis dem det her, eller send det."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no puede hacer crecer esta planta sin una semilla tuya. Enséñale esto o envíaselo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne peut pas faire pousser cette plante sans une graine de ta part. Montre-lui ceci, ou envoie-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non può far crescere questa pianta senza un seme da parte tua. Mostraglielo, oppure invialo."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan ikke dyrke fram denne planten uten et frø fra deg. Vis dem dette, eller send det."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan deze plant niet laten groeien zonder een zaadje van jou. Laat dit zien, of stuur het."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan inte odla fram den här växten utan ett frö från dig. Visa dem det här, eller skicka det."
          }
        }
      }
    },
    "%@ is here. A light tap, top to top." : {
      "comment" : "Under that title. %@ is the other person's name.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er her. Et let bank, top mod top."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está aquí. Un toque suave, borde superior con borde superior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est là. Un léger contact, haut contre haut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è qui. Un tocco leggero, cima contro cima."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ er her. Et lett dunk, topp mot topp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is er. Een licht tikje, bovenkant tegen bovenkant."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ är här. En lätt knackning, topp mot topp."
          }
        }
      }
    },
    "%@ moved out of range before the plant took." : {
      "comment" : "A failure. %@ is the other person's name; 'took' as a cutting takes.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kom uden for rækkevidde, før planten slog rod."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ se alejó antes de que la planta arraigara."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ n’était plus à portée avant que la plante ne prenne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ non era più a portata prima che la pianta attecchisse."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kom utenfor rekkevidde før planten slo rot."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ raakte buiten bereik voordat de plant aansloeg."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kom utom räckhåll innan växten tog sig."
          }
        }
      }
    },
    "%lld across %lld" : {
      "comment" : "The value beside 'Petals': %1$lld petals arranged across %2$lld layers. No noun is written, in English or in any translation — which is what saves it from needing a plural. If a language cannot say it without the noun, ask for a plural variation rather than guessing.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld på %2$lld"
          }
        },
        "en" : {
