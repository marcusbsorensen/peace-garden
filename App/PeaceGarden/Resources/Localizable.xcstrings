          }
        }
      }
    },
    "That seed and this one would grow different plants on each phone, so nothing was planted." : {
      "comment" : "Shown when a seed that arrived by link could not be crossed with this phone's own.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det frø og dette ville gro forskellige planter frem på hver telefon, så der blev ikke plantet noget."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa semilla y esta harían crecer plantas distintas en cada teléfono, así que no se plantó nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette graine et celle-ci feraient pousser des plantes différentes sur chaque téléphone, donc rien n’a été planté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quel seme e questo farebbero crescere piante diverse su ciascun telefono, quindi non è stato piantato nulla."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det frøet og dette ville gro fram ulike planter på hver telefon, så ingenting ble plantet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat zaadje en dit zaadje zouden op elke telefoon een andere plant laten groeien, dus er is niets geplant."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det fröet och det här skulle ge olika växter på varje telefon, så ingenting planterades."
          }
        }
      }
    },
