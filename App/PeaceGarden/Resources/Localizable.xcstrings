    "What this plant says about the meeting. What it grows from stays as it is." : {
      "comment" : "Under the title of the screen for changing a kept plant's story. The seed and the lineage are untouched by anything on that screen.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad denne plante fortæller om mødet. Det, den vokser af, bliver, som det er."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que esta planta dice del encuentro. Aquello de lo que crece se queda como está."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que cette plante dit de la rencontre. Ce dont elle pousse reste tel quel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che questa pianta dice dell’incontro. Ciò da cui cresce resta com’è."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hva denne planten sier om møtet. Det den vokser av, blir som det er."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wat deze plant over de ontmoeting zegt. Waar hij uit groeit, blijft zoals het is."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vad den här växten säger om mötet. Det den växer ur förblir som det är."
          }
        }
      }
    },
