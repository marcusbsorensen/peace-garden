    "This cannot be undone. The plant cannot be grown again." : {
      "comment" : "The message in the alert confirming that one plant is being let go.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan ikke fortrydes. Planten kan ikke gro igen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto no se puede deshacer. Esta planta no volverá a crecer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "C’est sans retour. Cette plante ne repoussera pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si può annullare. Questa pianta non ricrescerà."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette kan ikke angres. Planten kan ikke gro igjen."
          }
        },
        "nl" : {
          "stringUnit" : {
