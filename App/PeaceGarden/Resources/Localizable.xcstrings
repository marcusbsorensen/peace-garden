    "Your name" : {
      "comment" : "The name field's own label. It is hidden on screen and read aloud by VoiceOver.",
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit navn"
          }
        },
        "es" : {
