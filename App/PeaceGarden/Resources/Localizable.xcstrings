            "state" : "translated",
            "value" : "Tu nombre"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton nom"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo nome"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Navnet ditt"
          }
        },
        "nl" : {
