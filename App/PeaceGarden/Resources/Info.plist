<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Peace Garden</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string></string>
	</dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>accelerometer</string>
	</array>
	<!-- A phone is held one way; the composition assumes it. An iPad gets
	     picked up from whichever side is nearest, and supporting every
	     orientation is also what lets it be used in Split View. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIStatusBarHidden</key>
	<true/>

	<!-- Multipeer Connectivity is the transport for a face-to-face exchange.
	     Both keys are required from iOS 14: the description is shown in the
	     local-network prompt, and the service list must name the Bonjour
	     service in ExchangeProtocol.serviceType or discovery silently fails. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Peace Garden can record the coordinates of a spot where you met someone, so a plant remembers where it came from. The coordinates stay on this phone, and a meeting keeps them only when both of you have asked for it.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Peace Garden uses the local network to find the phone you are meeting, so your two seeds can be crossed directly between your devices. Nothing is sent to a server.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pg-pollen._tcp</string>
		<string>_pg-pollen._udp</string>
	</array>

	<!-- The accelerometer recognises the moment the two phones are tapped
	     together. It is only read while the Meet screen is open. -->
	<key>NSMotionUsageDescription</key>
	<string>Peace Garden feels the moment you tap your phone against someone else's, so a meeting has to be deliberate. Motion is only read while the Meet screen is open.</string>
</dict>
</plist>
