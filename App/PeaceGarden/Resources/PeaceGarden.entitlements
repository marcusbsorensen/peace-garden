<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Seed links. Both entries need the matching apple-app-site-association
	     file served from https://peacegarden.app/.well-known/, and the domain
	     has to be one you actually control. See docs/SEEDS-ON-THE-WIND.md. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:peacegarden.app</string>
		<string>appclips:peacegarden.app</string>
	</array>
</dict>
</plist>
