<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Seed links. Both entries need the apple-app-site-association file in
	     Server/ to be live at https://peacegarden.app/.well-known/ before iOS
	     will honour them. See Server/README.md. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:peacegarden.app</string>
		<string>appclips:peacegarden.app</string>
	</array>
</dict>
</plist>
