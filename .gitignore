# Generated by XcodeGen
*.xcodeproj/
*.xcworkspace/

# Swift Package Manager
.build/
.swiftpm/
Package.resolved

# Xcode
DerivedData/
xcuserdata/

# Preview output
tools/preview/*.png
__pycache__/

# Agent worktrees
.claude/worktrees/

# Seeded design canvas — generated from the .dc.html sources beside it
design/*.html
!design/*.dc.html

.DS_Store
design/garden/peace-garden-shared-garden.html
manus-output/
out/
build/

# The Yale Bright Star Catalogue, fetched once by hand and not ours to
# redistribute here. tools/sky/pack.py says where it comes from; its output,
# App/PeaceGarden/Resources/stars.bin, is committed.
tools/sky/bsc5.dat

# The plant renderer, eight megabytes of Swift built for wasm32 by
# tools/wasm/build.sh, and the two compressed copies `Server/index.php` serves
# from. Deployed from Server/.pages/ and rebuilt rather than committed: a binary
# this size in the history costs every clone forever, and it is reproducible
# from the sources beside it.
Server/.pages/PlantWasm.wasm
Server/.pages/PlantWasm.wasm.gz
Server/.pages/PlantWasm.wasm.br

# Where the SeedCore suite is built for WebAssembly, which is how the
# macOS/Linux divergence of 22 September was reproduced on this Mac instead of
# by pushing and waiting for CI:
#   swift build --package-path Packages/SeedCore --build-tests \
#     --swift-sdk swift-6.3.3-RELEASE_wasm --scratch-path .build-wasm
#   node tools/wasm/run-wasi.mjs .build-wasm/debug/SeedCorePackageTests.xctest
.build-wasm/
