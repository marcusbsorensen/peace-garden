# The association file has no extension, and a host that guesses at its type
# guesses `text/plain`. iOS reads the header rather than the contents and
# declines the domain without saying why, which is the single most common way
# associated domains fail silently.
<Files "apple-app-site-association">
    ForceType application/json
</Files>

# No redirects on this path, not even http to https: iOS follows none of them
# and treats a 301 as a missing file.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^apple-app-site-association$ - [L]
</IfModule>
