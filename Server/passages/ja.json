[
 {
  "text": "種の皮が割れると、芽より先に根が出る。下へ向かうほうが先で、上へ伸びるのはそのあとである。",
  "source": "植物学",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "石走る垂水の上のさわらびの萌え出づる春になりにけるかも",
  "source": "志貴皇子『万葉集』",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "草木萌動という五日間が暦にある。雨水の末候で、草木がいっせいに芽を吹きはじめるころにあたる。",
  "source": "略本暦・七十二候",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "タケノコは一日に一メートル近く伸びることがある。地下の茎が何年もかけて蓄えたものを、数週間で使い切る。",
  "source": "植物学",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "「初」は衣へんに刀と書く。布にはじめて刃を入れるところから作られた字である。",
  "source": "漢字の成り立ち",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "うぐいすの若い鳥は、はじめのうち節が定まらない。ぐぜりと呼ばれる、まだ下手なころの声である。",
  "source": "鳥類学",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "気象庁は一九五三年から、うぐいすの初鳴きやつばめの初見を毎年記録してきた。季節のはじまりに日付をつける仕事である。",
  "source": "生物季節観測",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "セミの幼虫は日が暮れてから土を出て木をのぼり、夜のうちに背を割る。羽が伸びきるまでに数時間かかる。",
  "source": "昆虫学",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "一番茶は、冬のあいだ休んでいた木がその年にはじめて出す葉のことをいう。二番茶とは香りが違う。",
  "source": "農学",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "ハスはまず水に浮く葉を出し、あとから水の上に立つ葉を出す。立ち葉が出てはじめて花が咲く。",
  "source": "植物学",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "書き初めは正月二日に書く。その年にはじめて筆を持つ日が決めてある。",
  "source": "年中行事",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "卵から出るとき、ひなは嘴の先にある小さな突起で殻を内側から叩く。この突起は孵ってしばらくすると取れてしまう。",
  "source": "鳥類学",
  "theme": "beginnings",
  "subtheme": "theFirstAct"
 },
 {
  "text": "やまとうたは、人の心を種として、よろづの言の葉とぞなれりける。",
  "source": "紀貫之『古今和歌集仮名序』",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "栴檀は双葉より芳し。",
  "source": "ことわざ",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "山椒は小粒でもぴりりと辛い。",
  "source": "ことわざ",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "塵も積もれば山となる。",
  "source": "ことわざ",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "ケヤキの種は数ミリしかなく、枯れた小枝ごと風に乗って飛ぶ。育った木は三十メートルになる。",
  "source": "植物学",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "ミツバチが一匹の生涯で集める蜜は、小さじ一杯にも足りない。巣にある蜜はその積み重ねである。",
  "source": "養蜂",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "コケの胞子は目に見えない大きさで飛ぶ。石の上に緑がひとところ出れば、そこに数えきれないほど着いたということである。",
  "source": "植物学",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "米粒につく麹菌の菌糸は目に見えない。それが樽ひとつぶんの酒を動かす。",
  "source": "醸造",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "日本には室町のころから、麹の種だけを売る商いがある。種麹屋という。",
  "source": "醸造史",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "和紙は楮の皮の繊維でできている。一本一本は髪より細いが、絡み合って千年もつ紙になる。",
  "source": "製紙",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "盆栽は小さく作るのではなく、小さいまま古くする。鉢の松の幹に皺が出るまでに何十年もかかる。",
  "source": "園芸",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "サンゴの一つの個体は数ミリしかない。沖縄の海にある群体は、それが何百年も重なったものである。",
  "source": "海洋生物学",
  "theme": "beginnings",
  "subtheme": "smallToLarge"
 },
 {
  "text": "新しき年の初めの初春の今日降る雪のいやしけ吉事",
  "source": "大伴家持『万葉集』",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "三つ子の魂百まで。",
  "source": "ことわざ",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "一年の計は元旦にあり。",
  "source": "ことわざ",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "初心忘るべからず。",
  "source": "ことわざ",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "何となく、今年はよい事あるごとし。元日の朝、晴れて風無し。",
  "source": "石川啄木『悲しき玩具』",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "接ぎ木は台木と穂木の形成層をぴったり合わせて縛る。ここが合っていなければ、あとは何をしてもつかない。",
  "source": "園芸",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "種を蒔く深さは、その種の大きさの二、三倍と決まっている。深すぎれば芽は地上まで届かない。",
  "source": "農学",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "木造の家は、まず一本目の柱を垂直に立てる。あとの柱はすべてそれを基準にして立つ。",
  "source": "建築",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "相撲の立合いは行司が決めるものではない。両者の呼吸が合ったところで始まる。",
  "source": "相撲",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "碁は何も置かれていない盤から始める。最初の一手だけは、どこに打っても間違いにならない。",
  "source": "囲碁",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "一富士二鷹三茄子。正月に見る夢の吉例で、順番まで決まっている。",
  "source": "年中行事",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "藍甕は最初の一週間で決まるといわれる。温度と灰汁の加減をそこで外すと、あとで戻すのが難しい。",
  "source": "染織",
  "theme": "beginnings",
  "subtheme": "whatAStartSettles"
 },
 {
  "text": "一九五一年、千葉の遺跡から掘り出された二千年以上前のハスの実が芽を出した。発掘した大賀一郎の名で大賀ハスと呼ばれている。",
  "source": "植物学",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "種は条件がそろっても芽を出さないことがある。外からではなく内側で止めている。これを休眠という。",
  "source": "植物学",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "木の冬芽は夏のうちにできあがっている。秋も冬も、鱗に包まれたまま開かずにいる。",
  "source": "植物学",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "桜の花芽は前の年の夏にできる。秋と冬の寒さを一定の期間受けないと、春が来ても開かない。",
  "source": "植物学",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "麦は寒さに当たらないと穂を出さない。冬を通ったかどうかを、植物のほうが数えている。",
  "source": "農学",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "待てば海路の日和あり。",
  "source": "ことわざ",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "果報は寝て待て。",
  "source": "ことわざ",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "石の上にも三年。",
  "source": "ことわざ",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "ヤマユリは種を蒔いてから花が咲くまでに五年から七年かかる。",
  "source": "園芸",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "クマの受精卵は秋のあいだ子宮に着かないまま漂っている。母の体が足りていれば、冬眠に入ってから着床する。",
  "source": "動物学",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "漆は乾かすのではなく、湿った暗いところに置いて固める。からりと乾いた場所では固まらない。",
  "source": "工芸",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "味噌は仕込んでから一冬か二冬置く。手を入れるのは年に一度か二度でよい。",
  "source": "醸造",
  "theme": "waiting",
  "subtheme": "heldBack"
 },
 {
  "text": "マダケは百二十年に一度花を咲かせるという説が有力で、日本では一九六〇年代に咲いた。次はおよそ二〇九〇年ごろになる。",
  "source": "植物学",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "屋久島の杉には樹齢が千年を超えるものがある。雨が多く土が痩せていて、育ちが遅いためだといわれる。",
  "source": "林学",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "鶴は千年亀は万年。",
  "source": "ことわざ",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "亀の甲より年の功。",
  "source": "ことわざ",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "月日に関守なし。",
  "source": "ことわざ",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "伊勢の神宮は二十年ごとに社殿を建て替える。二〇一三年のものが第六十二回にあたる。",
  "source": "神宮式年遷宮",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "旧暦十六日の月はいざよい、十七日は立待月、十八日は居待月、十九日は寝待月。待つ姿勢がそのまま名前になっている。",
  "source": "暦",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "月の出は一日ごとに平均およそ五十分ずつ遅くなる。待つ時間が毎晩少しずつ長くなっていく。",
  "source": "天文学",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "八十八夜は立春から数えて八十八日目、いまの暦では五月二日ごろ。八十八夜の別れ霜といって、遅霜の目安にする。",
  "source": "雑節",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "二百十日も立春から数える。風の強く吹くころとして、農家が古くから目印にしてきた。",
  "source": "雑節",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "十干と十二支を組み合わせると六十通りになる。一巡りするのに六十年かかる。",
  "source": "暦",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "輪島塗は下地から仕上げまで百をこえる工程を踏む。椀ひとつに半年以上かかる。",
  "source": "工芸",
  "theme": "waiting",
  "subtheme": "theLongCount"
 },
 {
  "text": "二十三夜などの晩に人が集まり、飲み食いをしてから月の出を待った。その記念に道ばたへ立てた石を月待塔という。",
  "source": "民俗",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "桜の開花は、気象台が決めた一本の木を見て判断する。その標本木に花が数輪開けば、その土地の開花である。",
  "source": "気象観測",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "霞立つ天の川原に君待つとい行き帰るに裳の裾濡れぬ",
  "source": "山上憶良『万葉集』",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "十五夜の前の晩を待宵という。まだ満ちきらない月を、明日を思いながら見る晩である。",
  "source": "暦",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "カワセミは水面の上の枝で長いあいだ動かない。狙いが定まるまで、羽根一本も動かさない。",
  "source": "鳥類学",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "アオサギは浅瀬に立ったまま何十分も動かないことがある。首を伸ばすのは一度でよい。",
  "source": "鳥類学",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "おみくじには待ち人という項目がある。来る、来たらず、遅けれど来る、と書いてある。",
  "source": "民俗",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "鷹乃学習。小暑の末候にあたり、鷹の幼い鳥が飛ぶことを覚えるころをいう。",
  "source": "略本暦・七十二候",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "蛍がいちばんよく飛ぶのは日が暮れてしばらくのあいだで、そのあとは数が減っていく。",
  "source": "昆虫学",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "いくたびも雪の深さを尋ねけり",
  "source": "正岡子規",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "定置網は魚を追わない。通り道に垣を張っておいて、入ってくるのを待つ漁である。",
  "source": "漁業",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "潮干狩りは干潮の一、二時間前から始める。潮の表を見て、その日の何時に浜が出るかを先に調べておく。",
  "source": "海洋",
  "theme": "waiting",
  "subtheme": "standingAndWatching"
 },
 {
  "text": "切り株や根元から出る若芽をひこばえという。太い幹に対して孫に見立てた「孫生え」が語源である。",
  "source": "日本語・林学",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "刈ったあとの稲株から出る芽を穭という。穭の伸びた田を穭田と呼ぶ。",
  "source": "農学",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "切った株から出る芽で林を作り直すことを萌芽更新という。かつての里山はこれで保たれていた。",
  "source": "林学",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "炭にするために同じ高さで何度も伐られたクヌギは、幹の上が台のようにふくらむ。台場クヌギと呼ばれる。",
  "source": "林学",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "茶は一年に何度も摘む。摘んだところから新しい芽が出るので、一番茶、二番茶、三番茶と続いていく。",
  "source": "農学",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "ニラは根を残して刈ればまた伸びる。一度植えれば何年も同じ株から採れる。",
  "source": "園芸",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "養蚕の桑畑は毎年切り詰める。切るほど柔らかい葉が出て、蚕がよく食べる。",
  "source": "養蚕",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "麋角解。冬至の次候にあたり、大鹿が角を落とすころをいう。落ちたところから、春にまた生えてくる。",
  "source": "略本暦・七十二候",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "ワラビもゼンマイも、生えたものを全部は採らない。次の年のために何本か残して摘む。",
  "source": "民俗",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "和紙の原料の楮は毎年株元から刈る。刈った株から翌年また枝が立つので、同じ株を何十年も使う。",
  "source": "製紙",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "ニホントカゲの尾は切れてもまた伸びるが、二度目の尾の芯は骨ではなく軟骨でできている。",
  "source": "動物学",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "木は切られたところのすぐ下から芽を出す。どこで切るかで、次にどちらへ伸びるかが決まる。",
  "source": "園芸",
  "theme": "renewal",
  "subtheme": "cutAndComeAgain"
 },
 {
  "text": "年のうちに春は来にけりひととせを去年とやいはむ今年とやいはむ",
  "source": "在原元方『古今和歌集』",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "春過ぎて夏来るらし白栲の衣干したり天の香具山",
  "source": "持統天皇『万葉集』",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "袖ひちてむすびし水のこほれるを春立つけふの風やとくらむ",
  "source": "紀貫之『古今和歌集』",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "暑さ寒さも彼岸まで。",
  "source": "ことわざ",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "東風解凍。立春の初候にあたり、春の風が氷をとかしはじめるころをいう。七十二候の第一である。",
  "source": "略本暦・七十二候",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "雪下出麦。冬至の末の五日で、雪の下にいる麦が芽を出しているころとされる。",
  "source": "略本暦・七十二候",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "干支が一巡りして生まれた年の組み合わせに戻ることを還暦という。赤いものを贈るのは、生まれ直すという見立てからである。",
  "source": "暦・民俗",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "立春のあとにはじめて吹く強い南風を春一番という。もとは壱岐の漁師のことばだったといわれる。",
  "source": "気象",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "桜の咲くころに戻ってくる寒さを花冷えという。冷えているあいだは花が長くもつ。",
  "source": "日本語・気象",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "衣替えを六月一日と十月一日にする習わしは、平安の宮中の更衣から続いている。",
  "source": "年中行事",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "半夏生は夏至から十一日目ごろ。田植えはこの日までに終えるものとされてきた。",
  "source": "雑節",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "山茶始開は立冬の最初の五日で、山茶花が咲きだすころ。冬に入っていちばん先に咲く花になる。",
  "source": "略本暦・七十二候",
  "theme": "renewal",
  "subtheme": "theTurningYear"
 },
 {
  "text": "割れた器は漆で接ぎ、継ぎ目に金粉を蒔く。直したところを隠さずに見せる直し方である。",
  "source": "工芸",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "刺し子は布の薄くなったところに糸を刺して厚みを戻す。模様は、補強のかたちがそのまま残ったものである。",
  "source": "工芸",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "青森などでは、古い木綿を継ぎ足しては使い続けた。何代も継がれた布をぼろと呼ぶ。",
  "source": "民俗",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "雨降って地固まる。",
  "source": "ことわざ",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "禍を転じて福となす。",
  "source": "ことわざ",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "金継ぎには呼継ぎという直し方がある。欠けたところに、まったく別の器のかけらを合わせて継ぐ。",
  "source": "工芸",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "木は傷を治さない。傷のまわりに新しい組織を巻いていって、傷ごと包んでしまう。",
  "source": "樹木学",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "傷んだ柱は全部を取り替えずに、悪いところだけ切って新しい木を継ぐ。金輪継ぎという継ぎ方がある。",
  "source": "建築",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "伊勢の遷宮で受け渡されるのは建物ではなく、建てる手のほうである。二十年ごとに、次の代がもう一度おぼえる。",
  "source": "建築史",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "田の畦は毎年塗り直す。土を水で練って手で塗るので、去年の畦の上に今年の畦が乗っていく。",
  "source": "農学",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "障子は年に一度張り替える。破れたところだけ、桜や紅葉の形に切った紙を貼ることもある。",
  "source": "民俗",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "湯治は一度に長く浸かるのではなく、日を重ねる。七日を一廻りとして、三廻り二十一日を一区切りとした。",
  "source": "民俗",
  "theme": "renewal",
  "subtheme": "madeWhole"
 },
 {
  "text": "春はあけぼの。やうやう白くなりゆく山ぎは、少し明りて、紫だちたる雲の細くたなびきたる。",
  "source": "清少納言『枕草子』",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "東の野にかぎろひの立つ見えてかへり見すれば月かたぶきぬ",
  "source": "柿本人麻呂『万葉集』",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "たそがれは「誰そ彼」から出た言葉で、暗くて相手が誰か分からなくなる時分をいう。",
  "source": "日本語の語源",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "明け方には「かはたれ時」という言い方がある。こちらも「彼は誰」で、同じ薄明かりを朝の側から呼んだものである。",
  "source": "古語",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "しののめは、もとは明かりを取るために編んだ竹の目のことだといわれる。そこから夜明けの空を指すようになった。",
  "source": "日本語の語源",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "夜が明けても空に残っている月を有明の月という。ひと月のうち、下弦を過ぎたころに見える。",
  "source": "暦・天文",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "早起きは三文の徳。",
  "source": "ことわざ",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "日が沈んでから空が完全に暗くなるまでには一時間近くかかる。太陽が地平線の下十八度に下がるまでを薄明という。",
  "source": "天文学",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "夕暮れを逢魔が時ともいう。人の顔が見分けにくくなる時分につけられた名である。",
  "source": "民俗",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "わたしたちは、氷砂糖をほしいくらいもたないでも、きれいにすきとおった風をたべ、桃いろのうつくしい朝の日光をのむことができます。",
  "source": "宮沢賢治『注文の多い料理店』序",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "明けの明星と宵の明星は同じ金星である。朝に見えるか夕に見えるかで、呼び名だけが変わる。",
  "source": "天文学",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "江戸の時刻は明け六つと暮れ六つで区切られ、日の出入りに合わせて一刻の長さが季節ごとに伸び縮みした。",
  "source": "暦",
  "theme": "light",
  "subtheme": "theEdgesOfTheDay"
 },
 {
  "text": "花は盛りに、月は隈なきをのみ見るものかは。",
  "source": "吉田兼好『徒然草』",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "春の夜の闇はあやなし梅の花色こそ見えね香やは隠るる",
  "source": "凡河内躬恒『古今和歌集』",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "ゲンジボタルの光る間隔は、西日本でおよそ二秒、東日本でおよそ四秒。境目はフォッサマグナの西のふちにある。",
  "source": "昆虫学",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "雲の形や空の色から天気を読むことを観天望気という。漁師や農家が土地ごとに違う言い方を持っている。",
  "source": "気象",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "灯台下暗し。",
  "source": "ことわざ",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "朝焼けは雨、夕焼けは晴れ。",
  "source": "ことわざ",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "障子の紙は光を通して、姿は通さない。外の明るさだけが部屋に入ってくる。",
  "source": "建築",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "障子の下半分を上げ下げできるようにしたものを雪見障子という。座ったまま外が見える高さになっている。",
  "source": "建築",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "キクは夜の長さを測って蕾をつくる。夜中に電灯を一時間つけるだけで、その計算は狂う。",
  "source": "植物学",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "菊の農家は温室に電灯をつけて花の時期をずらす。植物が夜を数えていることを、そのまま利用している。",
  "source": "農学",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "梅が香のたちのぼりてや月の暈",
  "source": "与謝蕪村『蕪村句集』",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "虹始見。清明の末候にあたり、雨のあとに虹が出はじめるころをいう。小雪には虹蔵不見があり、虹を見かけなくなるころとされる。",
  "source": "略本暦・七十二候",
  "theme": "light",
  "subtheme": "readingTheLight"
 },
 {
  "text": "木漏れ日は、葉のあいだを通ってきた日の光だけを指す言葉である。",
  "source": "日本語",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "木漏れ日の粒が丸いのは、葉の隙間の形ではなく太陽そのものの形が地面に映っているからである。",
  "source": "光学",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "夜でも桜のあたりだけがほのかに明るく見えることを花明かりという。",
  "source": "日本語",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "うつくしや障子の穴の天の川",
  "source": "小林一茶『七番日記』",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "名月を取てくれろとなく子かな",
  "source": "小林一茶『七番日記』",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "「ひさかたの」は光や天にかかる枕詞である。千年以上のあいだ、歌のなかではこの五文字が光の前に置かれてきた。",
  "source": "和歌",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "ホタルの光はほとんど熱を出さない。燃えているわけではないので、手にのせても熱くない。",
  "source": "昆虫学",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "波打ちぎわだけが青く光ることがある。ヤコウチュウという小さな生き物が、揺すられて光っている。",
  "source": "海洋生物学",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "行灯は火を紙で囲ったものである。明るくするための道具というより、まぶしくしないための道具である。",
  "source": "民具",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "雪の積もった晩は、月がなくても外の様子が見える。これを雪明かりという。",
  "source": "日本語",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "赤蜻蛉筑波に雲もなかりけり",
  "source": "正岡子規",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "富山湾では春に蜃気楼が出る。冷たい水の上の空気が光を曲げて、対岸の景色を持ち上げて見せる。",
  "source": "気象学",
  "theme": "light",
  "subtheme": "lightItself"
 },
 {
  "text": "雪を六花という。結晶が六角になることからついた名で、六つの花とも書く。",
  "source": "日本語",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "古河藩主の土井利位は顕微鏡で雪の結晶を写しとり、一八三二年に『雪華図説』として世に出した。",
  "source": "博物学",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "日本語では鳥も兎も一羽、二羽と数える。",
  "source": "日本語",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "神は一柱、二柱と数える。数えるときだけ、柱ということばになる。",
  "source": "日本語",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "蝶を数えるとき一頭ということがある。昆虫学の標本の数え方から来たといわれる。",
  "source": "日本語",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "古い日本語では八がたくさんの意味で使われた。八百万も八重も八千代も、正確な数ではない。",
  "source": "古語",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "俳句は五、七、五の十七音でできている。音の数であって、文字の数ではない。",
  "source": "俳句",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "大晦日の鐘は多くの寺で百八回撞かれる。年内に百七回、年が明けてから最後の一回を撞くところもある。",
  "source": "年中行事",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "一年を二十四に分けたものが二十四節気、それをさらに三つに割ったものが七十二候。一つがおよそ五日にあたる。",
  "source": "暦",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "畳の大きさは土地によって違う。京間と江戸間では、同じ六畳でも部屋の広さが変わる。",
  "source": "建築",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "数え年では、生まれた日に一歳になり、正月が来ると全員が同時に一つ増える。誕生日を数えない数え方である。",
  "source": "暦",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "一汁三菜は、汁ものが一つに菜が三つという意味である。数のほうが先に決まっていて、中身はあとで決める。",
  "source": "食文化",
  "theme": "pattern",
  "subtheme": "counted"
 },
 {
  "text": "日本の木造には釘を使わない継ぎ方が何十通りもある。木と木の側を刻んで、噛み合わせて留める。",
  "source": "建築",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "金輪継ぎは、二本の材を斜めに刻み合わせて栓を打ち、一本にする継ぎ方である。引いても外れない。",
  "source": "建築",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "組子は細い木を釘なしで組んだ格子で、麻の葉、胡麻がら、七宝といった模様の名がついている。",
  "source": "工芸",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "城の石垣には、石を切らずに積む野面積みという積み方がある。形の違う石の、合うところを探して合わせる。",
  "source": "石工",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "水は方円の器に従う。",
  "source": "ことわざ",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "畳の敷き方には決まりがあり、四枚の角が一点に集まらないように並べる。",
  "source": "建築",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "箱根の寄木細工は、色の違う木を貼り合わせて模様の棒をつくり、それを紙のように薄く削って貼る。",
  "source": "工芸",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "フジの蔓は右巻き、ヤマフジは左巻きと決まっている。同じ株のなかで向きが変わることはない。",
  "source": "植物学",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "木の葉は互いにできるだけ重ならない角度でつく。上から見ると、下の葉にも光が届くように並んでいる。",
  "source": "植物学",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "松かさの鱗片は、右回りと左回りの二通りの螺旋になって並ぶ。それぞれの本数は決まった数になる。",
  "source": "植物学",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "折り紙は切らずに折るだけで形をつくる。一枚の紙の、どこも捨てない。",
  "source": "工芸",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "障子の桟は縦横に組んで紙を貼る。紙の継ぎ目が桟に隠れるように、あらかじめ割りつけてある。",
  "source": "建築",
  "theme": "pattern",
  "subtheme": "fittedTogether"
 },
 {
  "text": "難波の葦は伊勢の浜荻。",
  "source": "ことわざ",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "名は体を表す。",
  "source": "ことわざ",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "吾輩は猫である。名前はまだ無い。",
  "source": "夏目漱石『吾輩は猫である』",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "寺院の号、さらぬ万の物にも、名を付くる事、昔の人は、少しも求めず、たゞ、ありのまゝに、やすく付けけるなり。",
  "source": "吉田兼好『徒然草』",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "序破急はもと雅楽の言葉で、はじめ、くずし、はやめの三段をいう。世阿弥はこれを芸ごと全体の言葉にした。",
  "source": "芸道",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "俳句の「や」「かな」「けり」を切れ字という。意味をそこで切って、一度立ち止まらせる字である。",
  "source": "俳句",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "「あしひきの」は山に、「たらちねの」は母にかかる。決まった語の前に置かれる五文字を枕詞という。",
  "source": "和歌",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "歌に詠まれてきた土地の名を歌枕という。名を出すだけで、その土地の季節と天気がついてくる。",
  "source": "和歌",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "歳時記は季語を春夏秋冬と新年に分け、そのなかを時候、天文、地理、生活、行事、動物、植物に分けている。",
  "source": "俳句",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "日本語には雨の名が多い。五月雨、時雨、小糠雨、霧雨、天気雨。降り方ごとに別の名がついている。",
  "source": "日本語",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "峠、辻、凪、榊は日本で作られた漢字である。中国から来た字では足りないものに、字のほうを作った。",
  "source": "国字",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "ブリは育つにつれて名前が変わる。関東ではワカシ、イナダ、ワラサ、ブリ。土地ごとに呼び名の並びが違う。",
  "source": "魚類学",
  "theme": "pattern",
  "subtheme": "orderNamed"
 },
 {
  "text": "日本の畑には黒ぼく土が多い。火山灰が積もったところに草が生えては枯れてを繰り返してできた土である。",
  "source": "土壌学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "関東ローム層は、富士や箱根の火山灰が長い年月をかけて降り積もったものである。",
  "source": "地質学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "落ち葉が土になるまでに数年かかる。踏んで音がするうちはまだ葉で、音がしなくなると土に近い。",
  "source": "土壌学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "ミミズは土を食べて土を出す。通ったあとに残る穴が、そのまま水と空気の道になる。",
  "source": "土壌学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "水田は水を張るために底を踏み固める。同じ土でありながら、上は柔らかく下は硬いという二重の作りになる。",
  "source": "農学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "痩せた田に別の土地の土を運び入れることを客土という。肥やしではなく、土そのものを足す。",
  "source": "農学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "湿地では枯れた植物が分解しきらずに積もる。釧路湿原の泥炭は、一年に一ミリほどの速さで厚くなってきた。",
  "source": "地質学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "一握りの土のなかには、目に見えない生き物が億の単位で入っている。",
  "source": "土壌学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "土間は家のなかにありながら土のままである。三和土は、土と石灰とにがりを混ぜて叩き固める。",
  "source": "建築",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "珪藻土は、大昔の海や湖にいた珪藻の殻が積もってできている。壁に塗ると湿気を吸う。",
  "source": "地質学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "焼畑は木を焼いた灰を肥やしにする。数年作ったら休ませ、林に戻るのを待ってからまた使う。",
  "source": "農学",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "陶土は掘ったあとしばらく寝かせる。水を含ませて置いておくと、粘りが出てくる。",
  "source": "陶芸",
  "theme": "ground",
  "subtheme": "theSoilItself"
 },
 {
  "text": "住めば都。",
  "source": "ことわざ",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "ふるさとの訛なつかし停車場の人ごみの中にそを聴きにゆく",
  "source": "石川啄木『一握の砂』",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "人はいさ心も知らずふるさとは花ぞ昔の香ににほひける",
  "source": "紀貫之『古今和歌集』",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "木曽路はすべて山の中である。",
  "source": "島崎藤村『夜明け前』",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "郷に入っては郷に従え。",
  "source": "ことわざ",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "生まれた土地の神を産土神という。よそへ移っても、生まれた場所の神は変わらないものとされた。",
  "source": "民俗",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "谷、沢、窪、洲。地名には、その土地の地形がそのまま残っていることが多い。",
  "source": "地名学",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "同じ言葉でも、土地によってどこを高く言うかが違う。橋と箸の言い分けは、東京と京都で逆になる。",
  "source": "方言学",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "同じ大根でも土地ごとに違う種が受け継がれてきた。練馬、聖護院、桜島。名前がそのまま産地である。",
  "source": "農学",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "同じ造り方をしても、仕込みの水で酒の味は変わる。灘の宮水は硬く、伏見の水は柔らかい。",
  "source": "醸造",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "白川郷の家の屋根が急なのは雪を落とすためで、その向きは谷を吹く風の向きで決まっている。",
  "source": "民家",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "日本の名字には地形から出たものが多い。山田、川口、中村、大谷。もとは住んでいる場所の言い方だった。",
  "source": "姓氏",
  "theme": "ground",
  "subtheme": "aPlaceYouAreFrom"
 },
 {
  "text": "里山は人が使い続けることで保たれる林である。薪を採り、落ち葉をさらい、伐っては生やしてきた。",
  "source": "林学",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "村ごとに社のまわりの木は切らずに残された。町でいちばん古い木が神社にあるのは、そのためである。",
  "source": "民俗",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "京都の円通寺の庭は、生垣の上に比叡山が入るように作ってある。庭の外の山を、庭の一部として借りる。",
  "source": "庭園",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "枯山水は水を使わずに水を表す庭である。白砂に筋を引き、石を据えて、流れを見せる。",
  "source": "庭園",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "苔の庭は植えるのではなく、掃いて育てる。落ち葉を除け続けていると、苔だけが残る。",
  "source": "庭園",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "山の斜面に石を積んで水平な面をつくったのが棚田である。一枚が畳数枚ほどしかない田もある。",
  "source": "農学",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "山の一部を村の共有として、誰でも薪や草を採ってよいことにした土地を入会地という。",
  "source": "民俗",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "家のつくりやうは夏をむねとすべし。",
  "source": "吉田兼好『徒然草』",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "生垣は毎年刈らないと形を保たない。刈るたびに枝が増えるので、年を追って厚くなっていく。",
  "source": "園芸",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "田へ水を引く用水は、村ごとに順番と時間が決められていた。水番という役の者が見て回った。",
  "source": "民俗",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "一九八五年、環境庁が全国から百か所の水を選んだ。選ぶ条件のひとつは、土地の人が守り続けていることだった。",
  "source": "名水百選",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "白砂の庭は毎朝掃き直す。砂に引いた筋は雨で消えるので、消えるたびにまた引く。",
  "source": "庭園",
  "theme": "ground",
  "subtheme": "aKeptPlace"
 },
 {
  "text": "名も知らぬ遠き島より流れ寄る椰子の実一つ",
  "source": "島崎藤村「椰子の実」",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "黒潮は南から北へ流れる暖かい海流で、南の島の木の実を日本の浜まで運んでくる。",
  "source": "海洋学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "ハマヒルガオやハマゴウの種は水に浮く。潮に乗って、別の浜に着いてから芽を出す。",
  "source": "植物学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "オナモミやセンダングサの実は服にくっつく。獣の毛につくためのかたちが、そのまま人にも効いている。",
  "source": "植物学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "カエデの実は二枚の羽をもち、落ちながら回る。回るぶんだけ落ちるのが遅くなり、風に乗る距離が伸びる。",
  "source": "植物学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "タンポポの綿毛は湿ると閉じ、乾くとまた開く。飛べない日には飛ばないようにできている。",
  "source": "植物学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "ヤマガラはエゴノキの実を木の皮の隙間などにいくつも隠す。隠した場所を全部は覚えていない。",
  "source": "鳥類学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "ヤドリギの実はねばつく。食べた鳥の嘴や枝にくっついて、そのまま木の上で芽を出す。",
  "source": "植物学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "日本海側の浜には、大陸や南の島から流れ着いたものが寄る。漁師はこれを寄り物と呼んできた。",
  "source": "民俗",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "スミレの実は乾くと三つに裂け、内側が縮んで種を弾き飛ばす。数メートル先まで飛ぶことがある。",
  "source": "植物学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "ハンノキの実は水に浮いて川を下り、下流の湿ったところに着く。川筋にハンノキが並ぶのはそのためである。",
  "source": "植物学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "竹は種ではなく地下茎で広がる。一年に何メートルも横へ伸びて、思わぬ場所から顔を出す。",
  "source": "植物学",
  "theme": "travel",
  "subtheme": "howASeedGoes"
 },
 {
  "text": "月日は百代の過客にして、行きかふ年もまた旅人なり。",
  "source": "松尾芭蕉『おくのほそ道』",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "分け入つても分け入つても青い山",
  "source": "種田山頭火『草木塔』",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "あるけばかつこういそげばかつこう",
  "source": "種田山頭火『草木塔』",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "急がば回れ。",
  "source": "ことわざ",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "可愛い子には旅をさせよ。",
  "source": "ことわざ",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "すこしの事にも先達はあらまほしきことなり。",
  "source": "吉田兼好『徒然草』",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "街道には日本橋から一里ごとに塚を築き、その上に榎や松を植えた。一里はおよそ三・九キロメートルである。",
  "source": "街道",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "峠は日本で作られた字で、山を上りきって下りにかかる点をいう。語源は手向けで、道祖神に手向けをした場所とされる。",
  "source": "国字・民俗",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "東海道には五十三の宿場があった。宿と宿のあいだは、おおむね一日で歩ける長さに割ってある。",
  "source": "街道",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "四国の八十八か所を歩いて回ると千百キロを超え、四十日ほどかかる。",
  "source": "民俗",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "遍路の笠には「同行二人」と書く。一人で歩いていても連れがいる、という意味である。",
  "source": "民俗",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "茶室へ行く庭には飛石が置いてある。歩幅より少し狭く並べてあるので、自然に足が遅くなる。",
  "source": "庭園",
  "theme": "travel",
  "subtheme": "theRoad"
 },
 {
  "text": "荒海や佐渡によこたふ天河",
  "source": "松尾芭蕉『おくのほそ道』",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "もりもりもりあがる雲へあゆむ",
  "source": "種田山頭火『草木塔』",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "ひとり燈火のもとに文をひろげて、見ぬ世の人を友とするこそ、こよなう慰むわざなれ。",
  "source": "吉田兼好『徒然草』",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "ニホンウナギは川で育ち、産卵にはマリアナ諸島の西の海まで行く。その場所が分かったのは二〇〇九年である。",
  "source": "魚類学",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "日本で冬を越すオオハクチョウは、春になるとシベリアまで帰る。同じ湖に、毎年同じ群れが来る。",
  "source": "鳥類学",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "日本のツバメの多くは冬を東南アジアで過ごす。春に戻ると、去年と同じ家の同じ巣に入ることがある。",
  "source": "鳥類学",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "アサギマダラという蝶は、羽に印をつけて放すと、千キロ以上離れた場所で見つかることがある。",
  "source": "昆虫学",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "天の川は、地球のいる銀河を内側から横に見ているものである。星が集まって帯に見えている。",
  "source": "天文学",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "奈良の正倉院には、西域やペルシャから来たものが納められている。千年以上前に、そこまでの道があった。",
  "source": "歴史",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "北極星はいま真北に近いが、地球の軸はゆっくり回っている。何千年か経つと、別の星が北を指す。",
  "source": "天文学",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "日本に降る黄砂は、大陸の乾いた土地から風で運ばれてくる。毎年、春に決まって届く。",
  "source": "気象学",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "サケは海で何年も過ごしてから、生まれた川へ戻る。川ごとの匂いを覚えていて、それを頼りに上ってくる。",
  "source": "魚類学",
  "theme": "travel",
  "subtheme": "farOff"
 },
 {
  "text": "袖の振り合わせも他生の縁。",
  "source": "ことわざ",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "一樹の蔭一河の流れも他生の縁。",
  "source": "ことわざ",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "縁は異なもの。",
  "source": "ことわざ",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "一期一会の一期は仏教のことばで、生まれてから死ぬまでをいう。一生に一度の会、という意味になる。",
  "source": "茶道",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "利休の弟子の山上宗二は、路地に入ってから出るまでを一期に一度の会として過ごせと書き残している。",
  "source": "山上宗二『山上宗二記』",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "村の境や辻には道祖神が立っている。男と女が並んで彫られたものが多く、通る人を見送っている。",
  "source": "民俗",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "辻は日本で作られた字で、道が十文字に交わるところをいう。",
  "source": "国字",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "名月やけさ見た人に行きちがひ",
  "source": "与謝蕪村『蕪村句集』",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "七夕の二つの星、織姫と彦星は十五光年ほど離れている。年に一度でも、実際に近づくことはない。",
  "source": "天文学",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "川の合流点を落合という。全国に落合という地名が多いのは、そこで二つの川が出会っているからである。",
  "source": "地名学",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "ゲンジボタルの雄は飛びながら光り、雌は草の上で光って答える。合図が合ったときだけ近づく。",
  "source": "昆虫学",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "一度きりの機会そのものを指して一期一会ということもある。もとは茶席についての言葉だった。",
  "source": "日本語",
  "theme": "meeting",
  "subtheme": "theMoment"
 },
 {
  "text": "魚心あれば水心あり。",
  "source": "ことわざ",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "破れ鍋に綴じ蓋。",
  "source": "ことわざ",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "阿吽は口を開く音と閉じる音である。狛犬も仁王も、一方が開いて一方が閉じていて、二体で一組になる。",
  "source": "仏教美術",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "マツタケはアカマツの根と組んでいる。菌が水と養分を渡し、松が糖を渡す。どちらか片方では育たない。",
  "source": "菌類学",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "イヌビワの実のなかにはイヌビワコバチしか入れない。木はこの蜂にしか受粉を頼まず、蜂はこの木でしか育たない。",
  "source": "植物学",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "クマノミはイソギンチャクの触手のあいだで刺されずに暮らす。かわりに掃除をし、外敵を追い払う。",
  "source": "海洋生物学",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "連歌は、五七五を詠んだ人に別の人が七七をつけていく。一人では一つの歌にならない形である。",
  "source": "連歌",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "連歌の第一句は客が詠み、それに答える第二句は亭主が詠むものとされた。挨拶を歌でするのである。",
  "source": "連歌",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "イチョウには雄の木と雌の木がある。実がなるのは雌の木で、それも近くに雄の木がいる場合にかぎる。",
  "source": "植物学",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "ソバは同じ株の花粉では実らない。別の株から来た花粉が要る。",
  "source": "植物学",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "餅は一人ではつけない。杵を振る者と、合間に手を入れて返す者が要る。",
  "source": "民俗",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "地衣類は菌と藻が一緒になったものである。切り離すと、どちらもいまの姿では生きていけない。",
  "source": "生物学",
  "theme": "meeting",
  "subtheme": "twoThatNeedEachOther"
 },
 {
  "text": "親しき中にも礼儀あり。",
  "source": "ことわざ",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "挨拶は時の氏神。",
  "source": "ことわざ",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "目は口ほどに物を言う。",
  "source": "ことわざ",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "挨拶はもと禅の言葉で、修行する者どうしが問いかけ合って互いのところを確かめることをいった。",
  "source": "日本語の語源",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "挨拶には仲裁という意味もある。二人のあいだに入って収めることを、いまでも挨拶という。",
  "source": "日本語",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "茶では、客を迎える前と、中立ちのときと、終わりに露地へ水を打つ。三度打つことになっている。",
  "source": "茶道",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "茶室の入口は低く小さく作ってある。誰であっても、身をかがめて入るほかない。",
  "source": "茶道",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "庭の飛石の上に、棕櫚縄を十文字に掛けた小石が置いてあることがある。この先は通らないでほしい、という合図である。",
  "source": "庭園",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "日本の手紙は用件より先に季節のことを書く。書き出しの一行には、月ごとに決まった言い方がある。",
  "source": "書簡",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "一晩泊めてもらい、一度食事をもらうことを一宿一飯という。それだけで恩と数える言い方である。",
  "source": "日本語",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "部屋には上座と下座がある。床の間に近いほうが上座で、入口に近いほうが下座になる。",
  "source": "作法",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "茶碗は正面を避けて飲む。客は少し回してから口をつけ、飲んだあとで正面を亭主のほうへ戻して返す。",
  "source": "茶道",
  "theme": "meeting",
  "subtheme": "theMannersOfIt"
 },
 {
  "text": "二本以上の木が同じ根から生えていることを相生という。高砂の相生の松は、赤松と黒松が一つの根から立っているとされる。",
  "source": "民俗・植物",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "枝と枝が長くこすれ合っていると、傷口どうしがくっついて一本につながることがある。連理という。",
  "source": "樹木学",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "接ぎ木でつないだ木は、上と下が別の木のままである。花は上の木のもの、根は下の木のものである。",
  "source": "園芸",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "ソメイヨシノは接ぎ木で増やしてきたので、どの木も遺伝的には同じ一本である。町じゅうの木がそろって咲くのはそのためである。",
  "source": "植物学",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "二見の夫婦岩は、大きい岩と小さい岩を大注連縄でつないである。縄は年に何度か張り替える。",
  "source": "民俗",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "蛙の子は蛙。",
  "source": "ことわざ",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "類は友を呼ぶ。",
  "source": "ことわざ",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "竹林の竹は地下でつながっている。別々に立っているように見えても、もとは一株のことが多い。",
  "source": "植物学",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "フジは自分では立てない。そばの木に巻きついて、その木の高さまで上がっていく。",
  "source": "植物学",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "苔は根を持たない。体じゅうから水を取り、隣の苔と重なり合って湿りを保っている。",
  "source": "植物学",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "一本の苗は何本にも分かれて増える。これを分けつという。田に立つ株は、もとは一粒の種である。",
  "source": "農学",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "藪のなかで隣り合ったアカマツの根は、地中で触れ合ううちにつながることがある。",
  "source": "樹木学",
  "theme": "kinship",
  "subtheme": "grownTogether"
 },
 {
  "text": "絆はもと、犬や馬をつないでおくための綱のことだった。",
  "source": "日本語の語源",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "旧暦の一月を睦月という。人が集まって睦み合う月という意味だといわれる。",
  "source": "暦・日本語",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "同じ母から生まれた者を「はらから」といった。腹を同じくする者、という意味である。",
  "source": "古語",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "相棒は、もと駕籠を担ぐ棒の反対の端を持つ人のことをいった。",
  "source": "日本語の語源",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "おかげさまの「かげ」は、日の当たらないところであり、庇いのことでもある。誰かの陰にいて助かった、という言い方である。",
  "source": "日本語",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "ご馳走の馳も走も、走るという意味の字である。客のために方々を駆け回って集めることをいった。",
  "source": "日本語の語源",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "「いってきます」と「いってらっしゃい」は対になっている。片方だけでは終わらない言い方である。",
  "source": "日本語",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "「ただいま」は「ただいま帰りました」の前半だけが残ったものである。",
  "source": "日本語",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "「お互い様」は、助けた側が言う言葉である。次はこちらが世話になる、という意味を含んでいる。",
  "source": "日本語",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "縁は仏教のことばで、物事がそうなるための条件をいう。縁側も縁組も縁起も、この一字から出ている。",
  "source": "日本語",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "おすそ分けの裾は着物の裾である。自分の端のほうを分ける、という言い方になっている。",
  "source": "日本語の語源",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "日本語では家も家族も「うち」という。うちの人、うちの子。建物と人が同じ一語になる。",
  "source": "日本語",
  "theme": "kinship",
  "subtheme": "theWordsForIt"
 },
 {
  "text": "三人寄れば文殊の知恵。",
  "source": "ことわざ",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "遠くの親類より近くの他人。",
  "source": "ことわざ",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "情けは人の為ならず。",
  "source": "ことわざ",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "我と来て遊べや親のない雀",
  "source": "小林一茶『おらが春』",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "銀も金も玉も何せむにまされる宝子にしかめやも",
  "source": "山上憶良『万葉集』",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "屋根を葺くときは村じゅうで一軒ずつ順に手伝う。労力を対等に交換するこの仕組みを結という。",
  "source": "民俗",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "少しずつ出し合って順に受け取る仕組みを講という。頼母子講、無尽などと呼ばれてきた。",
  "source": "民俗",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "向こう三軒両隣。向かいの三軒と左右の二軒が、近所という言葉の指してきた範囲である。",
  "source": "民俗",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "縁側は家の内でも外でもない。客ではない人が、上がらずに腰かけて話していける場所である。",
  "source": "建築",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "井戸は共同で使うものだったので、水を汲む人どうしが毎日顔を合わせた。井戸端会議という言葉はそこから出た。",
  "source": "民俗",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "田植えは大勢で横一列に並んで、後ろへ下がりながら植える。一人だけ早くても意味がない。",
  "source": "農学",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "瓜食めば子ども思ほゆ栗食めばまして偲はゆ",
  "source": "山上憶良『万葉集』",
  "theme": "kinship",
  "subtheme": "twoPeople"
 },
 {
  "text": "閑さや岩にしみ入る蝉の声",
  "source": "松尾芭蕉『おくのほそ道』",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "一九九六年、環境庁は残したい音のする場所を全国から百か所選んだ。流氷の音も、寺の鐘も、虫の声も入っている。",
  "source": "日本の音風景100選",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "手水鉢の下に甕を伏せて埋め、落ちた水滴の音を中で響かせる仕掛けを水琴窟という。",
  "source": "庭園",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "竹の筒に水が溜まると傾いてこぼれ、戻るときに石を打つ。添水といい、鹿威しとも呼ばれる。",
  "source": "庭園",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "知恩院や二条城の廊下は歩くと鳴る。忍び返しのためと長く言われてきたが、床板を留める金具が古びて動く音である。",
  "source": "建築",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "江戸には虫の声を聴きに出かける遊びがあり、道灌山などが虫聴きの名所とされた。",
  "source": "民俗",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "注連縄は、この先は静かにしておく場所だという印である。木にも岩にも張る。",
  "source": "民俗",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "日本の音楽では、音を出さないところも拍として数える。これを間という。",
  "source": "邦楽",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "音無という川の名が各地にある。流れの音がしないほど静かだからだといわれる。",
  "source": "地名学",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "しじまは、物音がまったくしない状態をいう古い言葉である。口を閉じて黙ることも、同じ語でいう。",
  "source": "古語",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "雪が降ると音が消えるのは、積もった雪が隙間だらけで、音をそこへ吸い込んでしまうからである。",
  "source": "音響学",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "スズムシの雄は羽をこすり合わせて鳴く。音を出す側の羽には、やすりのような細かい筋がついている。",
  "source": "昆虫学",
  "theme": "peace",
  "subtheme": "quietAsASound"
 },
 {
  "text": "和を以て貴しと為す。",
  "source": "ことわざ",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "言わぬが花。",
  "source": "ことわざ",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "改めて益なきことは、改めぬをよしとするなり。",
  "source": "吉田兼好『徒然草』",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "凪は日本で作られた字で、風と止を合わせてある。風がやんで波が静かになることをいう。",
  "source": "国字",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "海辺では朝と夕に風が止む時間がある。陸の風と海の風が入れ替わるあいだで、朝凪、夕凪という。",
  "source": "気象学",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "争いごとが収まったときに双方で手を打つことを、手打ちという。",
  "source": "日本語",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "もめごとをなかったことにして先へ進むことを、水に流すという。",
  "source": "日本語",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "和は、混ぜて調子を合わせるという意味の字である。和える、和らぐ、和音。どれも同じ字を使っている。",
  "source": "漢字",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "大晦日には、その年の掛け売りをすべて払って年を越した。持ち越さないことになっていた。",
  "source": "民俗",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "年の暮れに家じゅうを掃くことを煤払いという。十二月十三日と決めている土地が多い。",
  "source": "年中行事",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "集まりの終わりに全員で手を打つ。三本締めは三度、一本締めは一度で終わる。",
  "source": "民俗",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "鎮の字は金と真からできていて、重しを置いて動かないようにすることをいう。鎮守も文鎮も同じ字である。",
  "source": "漢字",
  "theme": "peace",
  "subtheme": "theWordsForStopping"
 },
 {
  "text": "つれづれなるままに、日ぐらし硯に向ひて、心に移り行くよしなしごとを、そこはかとなく書きつくれば、怪しうこそ物狂ほしけれ。",
  "source": "吉田兼好『徒然草』",
  "theme": "peace",
  "subtheme": "atEase"
 },
 {
  "text": "春の海終日のたりのたりかな",
  "source": "与謝蕪村『蕪村句集』",
  "theme": "peace",
  "subtheme": "atEase"
 },
 {
  "text": "悠然として山を見る蛙かな",
  "source": "小林一茶『おらが春』",
  "theme": "peace",
  "subtheme": "atEase"
 },
 {
  "text": "涼風の曲がりくねつて来たりけり",
  "source": "小林一茶『七番日記』",
  "theme": "peace",
  "subtheme": "atEase"
 },
 {
  "text": "鳴かぬなら鳴かなくてよいほととぎす",
  "source": "種田山頭火『草木塔』",
  "theme": "peace",
  "subtheme": "atEase"
 },
 {
  "text": "ここで泊ろうつくつくぼうし",
  "source": "種田山頭火『草木塔』",
  "theme": "peace",
  "subtheme": "atEase"
 },
 {
  "text": "不来方のお城の草に寝ころびて空に吸われし十五の心",
  "source": "石川啄木『一握の砂』",
  "theme": "peace",
  "subtheme": "atEase"
 },
 {
  "text": "笑う門には福来たる。",
  "source": "ことわざ",
  "theme": "peace",
  "subtheme": "atEase"
 },
 {
